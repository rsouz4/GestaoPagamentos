<UserControl x:Class="GestaoPagamentos.Wpf.Devedores.DevedoresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="3" Text="Devedores" Style="{StaticResource PageTitle}" Margin="0,0,0,16" />

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="Buscar" Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0" Command="{Binding BuscarCommand}" IsDefault="True" />
                    <TextBox Text="{Binding Filtro, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
                <DataGrid ItemsSource="{Binding Itens}" SelectedItem="{Binding Selecionado}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*" />
                        <DataGridTextColumn Header="Telefone" Binding="{Binding Telefone}" Width="140" />
                        <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="180" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="{Binding TituloFormulario}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Nome *" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Telefone (WhatsApp)" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Telefone, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="E-mail" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Observação" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Observacao, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                         Height="70" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Erro}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                           Margin="0,10,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="Salvar" Style="{StaticResource PrimaryButton}" Command="{Binding SalvarCommand}" />
                    <Button Content="Novo" Style="{StaticResource SecondaryButton}" Command="{Binding NovoCommand}" />
                    <Button Content="Excluir" Style="{StaticResource DangerButton}" Command="{Binding ExcluirCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
