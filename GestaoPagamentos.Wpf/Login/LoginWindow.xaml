<Window x:Class="GestaoPagamentos.Wpf.Login.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestão de Pagamentos — Entrar"
        Width="440" Height="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="28">
        <Border Style="{StaticResource Card}" VerticalAlignment="Center">
            <StackPanel>
                <Border Background="{StaticResource AccentGradientBrush}" CornerRadius="12"
                        Width="44" Height="44" HorizontalAlignment="Left" Margin="0,0,0,14">
                    <TextBlock Text="$" Foreground="White" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" />
                </Border>
                <TextBlock Text="Entrar" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Use o e-mail e a senha da sua conta." Style="{StaticResource MutedText}" Margin="0,2,0,8" />

                <TextBlock Text="E-mail" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="EmailBox" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Senha" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="SenhaBox" Padding="8,6" BorderBrush="{StaticResource BorderBrushSoft}"
                             PasswordChanged="SenhaBox_PasswordChanged" />

                <CheckBox Content="Manter conectado neste computador" IsChecked="{Binding ManterConectado}"
                          Margin="0,14,0,0" />

                <TextBlock Text="{Binding Erro}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                           Margin="0,10,0,0" />

                <Button Content="Entrar" Style="{StaticResource PrimaryButton}" IsDefault="True"
                        HorizontalAlignment="Stretch" Margin="0,16,0,0"
                        Command="{Binding EntrarCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
