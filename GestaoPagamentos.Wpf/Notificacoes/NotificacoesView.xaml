<UserControl x:Class="GestaoPagamentos.Wpf.Notificacoes.NotificacoesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Gerar notificações" Style="{StaticResource SecondaryButton}"
                        Command="{Binding GerarCommand}" />
                <Button Content="Enviar todas os atrasados" Style="{StaticResource DangerButton}"
                        Command="{Binding Ta Command}" Margin="0" />
            </StackPanel>
            <TextBlock Text="Notificações" Style="{StaticResource PageTitle}" />
        </DockPanel>

        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,12"
                   Visibility="{Binding LoteEmAndamento, Converter={StaticResource BoolToVisibility}}">
            <Button DockPanel.Dock="Right" Content="Cancelar lote" Style="{StaticResource SecondaryButton}"
                    Command="{Binding CancelarLoteCommand}" Margin="0" />
            <TextBlock Text="{Binding Progresso}" FontWeight="SemiBold" />
        </DockPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}">
            <DataGrid ItemsSource="{Binding Itens}" SelectedItem="{Binding Selecionada}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Tipo" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource StatusPill}"
                                        Background="{Binding Tipo, Converter={StaticResource StatusBrush}, ConverterParameter=bg}">
                                    <TextBlock Text="{Binding Tipo, Converter={StaticResource StatusTexto}}" FontSize="12"
                                               Foreground="{Binding Tipo, Converter={StaticResource StatusBrush}}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Devedor" Binding="{Binding DevedorNome}" Width="*" />
                    <DataGridTextColumn Header="Dívida" Binding="{Binding Descricao}" Width="*" />
                    <DataGridTextColumn Header="Parcela" Binding="{Binding NumeroParcela}" Width="70" />
                    <DataGridTextColumn Header="Vencimento" Binding="{Binding Vencimento, StringFormat=d}" Width="100" />
                    <DataGridTextColumn Header="Valor" Binding="{Binding Valor, StringFormat=C}" Width="100" />
                    <DataGridCheckBoxColumn Header="Fone OK" Binding="{Binding TelefoneValido, Mode=OneWay}" Width="70" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Mensagem" Style="{StaticResource SectionTitle}" />
                <TextBox Text="{Binding Mensagem, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                         TextWrapping="Wrap" Height="200" VerticalScrollBarVisibility="Auto" />
                <TextBlock Text="{Binding Erro}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                           Margin="0,10,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="Enviar no WhatsApp" Style="{StaticResource SuccessButton}"
                            Command="{Binding EnviarCommand}" />
                    <Button Content="Ignorar" Style="{StaticResource SecondaryButton}"
                            Command="{Binding IgnorarCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
