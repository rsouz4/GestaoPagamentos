<UserControl x:Class="GestaoPagamentos.Wpf.Notificacoes.NotificacoesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Atualizar" Style="{StaticResource SecondaryButton}"
                    Command="{Binding CarregarCommand}" Margin="0" />
            <StackPanel>
                <TextBlock Text="Log de notificações enviadas" Style="{StaticResource PageTitle}" />
                <TextBlock Text="As notificações são geradas e enviadas automaticamente." Style="{StaticResource MutedText}" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <DataGrid ItemsSource="{Binding Itens}" SelectedItem="{Binding Selecionada}" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Enviada em" Binding="{Binding DataEnvio, StringFormat=g}" Width="130" />
                    <DataGridTemplateColumn Header="Tipo" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource StatusPill}" Background="{Binding Tipo, Converter={StaticResource StatusBrush}, ConverterParameter=bg}">
                                    <TextBlock Text="{Binding Tipo, Converter={StaticResource StatusTexto}}" FontSize="12" Foreground="{Binding Tipo, Converter={StaticResource StatusBrush}}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Devedor" Binding="{Binding DevedorNome}" Width="*" />
                    <DataGridTextColumn Header="Dívida" Binding="{Binding Descricao}" Width="*" />
                    <DataGridTextColumn Header="Parcela" Binding="{Binding NumeroParcela}" Width="70" />
                    <DataGridTextColumn Header="Vencimento" Binding="{Binding Vencimento, StringFormat=d}" Width="100" />
                    <DataGridTextColumn Header="Valor" Binding="{Binding Valor, StringFormat=C}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Mensagem enviada" Style="{StaticResource SectionTitle}" />
                <TextBox Text="{Binding Mensagem, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="240" VerticalScrollBarVisibility="Auto" />
                <TextBlock Text="{Binding Erro}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
