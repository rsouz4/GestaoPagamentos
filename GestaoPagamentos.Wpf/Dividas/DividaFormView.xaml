<UserControl x:Class="GestaoPagamentos.Wpf.Dividas.DividaFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Nova dívida" Style="{StaticResource PageTitle}" Margin="0,0,0,16" />
        <Border Style="{StaticResource Card}" MaxWidth="560" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Devedor *" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Devedores}" SelectedItem="{Binding Devedor}" DisplayMemberPath="Nome" />
                <TextBlock Text="Descrição *" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Descricao, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Valor emprestado (R$) *" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding ValorEmprestado, UpdateSourceTrigger=LostFocus}" />
                <TextBlock Text="{Binding ValorAReceberTexto}" FontWeight="SemiBold" Margin="0,6,0,0" />
                <TextBlock Text="Tipo" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Tipos}" SelectedItem="{Binding Tipo}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource StatusTexto}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel Visibility="{Binding ExibeParcelas, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Quantidade de parcelas" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding QuantidadeParcelas, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <TextBlock Text="Primeiro vencimento" Style="{StaticResource FieldLabel}" />
                <DatePicker SelectedDate="{Binding PrimeiroVencimento}" />
                <TextBlock Text="Observação" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Observacao, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                         Height="60" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Erro}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                           Margin="0,10,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="Salvar" Style="{StaticResource PrimaryButton}" Command="{Binding SalvarCommand}" />
                    <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Command="{Binding CancelarCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
