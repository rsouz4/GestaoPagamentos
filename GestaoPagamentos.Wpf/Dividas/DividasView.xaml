<UserControl x:Class="GestaoPagamentos.Wpf.Dividas.DividasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding Filtros}" SelectedItem="{Binding Filtro}" DisplayMemberPath="Titulo"
                          Width="140" Margin="0,0,12,0" />
                <Button Content="Abrir" Style="{StaticResource SecondaryButton}" Command="{Binding AbrirCommand}" />
                <Button Content="Nova dívida" Style="{StaticResource PrimaryButton}" Command="{Binding NovaCommand}"
                        Margin="0" />
            </StackPanel>
            <TextBlock Text="Dívidas" Style="{StaticResource PageTitle}" />
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <DataGrid ItemsSource="{Binding Itens}" SelectedItem="{Binding Selecionada}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Devedor" Binding="{Binding DevedorNome}" Width="1.2*" />
                    <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="1.5*" />
                    <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo, Converter={StaticResource StatusTexto}}" Width="90" />
                    <DataGridTextColumn Header="Emprestado" Binding="{Binding ValorEmprestado, StringFormat=C}" Width="100" />
                                        <DataGridTextColumn Header="A receber" Binding="{Binding ValorTotal, StringFormat=C}" Width="100" />
                    <DataGridTextColumn Header="Pago" Binding="{Binding ValorPago, StringFormat=C}" Width="100" />
                    <DataGridTextColumn Header="Restante" Binding="{Binding ValorRestante, StringFormat=C}" Width="100" />
                    <DataGridTextColumn Header="Atrasadas" Binding="{Binding ParcelasAtrasadas}" Width="80" />
                    <DataGridTextColumn Header="Próx. venc." Binding="{Binding ProximoVencimento, StringFormat=d}" Width="100" />
                    <DataGridTemplateColumn Header="Status" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource StatusPill}"
                                        Background="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=bg}">
                                    <TextBlock Text="{Binding Status, Converter={StaticResource StatusTexto}}" FontSize="12"
                                               Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
