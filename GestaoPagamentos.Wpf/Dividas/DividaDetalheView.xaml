<UserControl x:Class="GestaoPagamentos.Wpf.Dividas.DividaDetalheView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancelar dívida" Style="{StaticResource DangerButton}"
                        Command="{Binding CancelarDividaCommand}" />
                <Button Content="Voltar" Style="{StaticResource SecondaryButton}" Command="{Binding VoltarCommand}"
                        Margin="0" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{Binding Divida.Descricao}" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource MutedText}">
                    <Run Text="{Binding Divida.DevedorNome, Mode=OneWay}" /> ·
                    <Run Text="{Binding Divida.Status, Mode=OneWay, Converter={StaticResource StatusTexto}}" />
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,40,0">
                    <TextBlock Text="Valor emprestado" Style="{StaticResource MutedText}" />
                    <TextBlock Text="{Binding Divida.ValorEmprestado, StringFormat=C}" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Margin="0,0,40,0">
                    <TextBlock Text="Valor a receber" Style="{StaticResource MutedText}" />
                    <TextBlock Text="{Binding Divida.ValorTotal, StringFormat=C}" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Margin="0,0,40,0">
                    <TextBlock Text="Pago" Style="{StaticResource MutedText}" />
                    <TextBlock Text="{Binding Divida.ValorPago, StringFormat=C}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource SuccessBrush}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Restante" Style="{StaticResource MutedText}" />
                    <TextBlock Text="{Binding Divida.ValorRestante, StringFormat=C}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource DangerBrush}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Parcelas" Style="{StaticResource SectionTitle}" />
                <DataGrid ItemsSource="{Binding Parcelas}" SelectedItem="{Binding ParcelaSelecionada}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nº" Binding="{Binding Numero}" Width="50" />
                        <DataGridTextColumn Header="Vencimento" Binding="{Binding DataVencimento, StringFormat=d}" Width="110" />
                        <DataGridTextColumn Header="Previsto" Binding="{Binding ValorPrevisto, StringFormat=C}" Width="*" />
                        <DataGridTextColumn Header="Pago" Binding="{Binding ValorPago, StringFormat=C}" Width="*" />
                        <DataGridTextColumn Header="Restante" Binding="{Binding ValorRestante, StringFormat=C}" Width="*" />
                        <DataGridTemplateColumn Header="Status" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatusPill}"
                                            Background="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=bg}">
                                        <TextBlock Text="{Binding Status, Converter={StaticResource StatusTexto}}" FontSize="12"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Registrar pagamento" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Valor (R$)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ValorPagamento, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Data" Style="{StaticResource FieldLabel}" />
                    <DatePicker SelectedDate="{Binding DataPagamento}" />
                    <TextBlock Text="Observação" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ObservacaoPagamento, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{Binding Erro}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                               Margin="0,10,0,0" />
                    <Button Content="Registrar" Style="{StaticResource SuccessButton}" Margin="0,14,0,0"
                            Command="{Binding RegistrarPagamentoCommand}" />

                    <TextBlock Text="Pagamentos da parcela" Style="{StaticResource SectionTitle}" Margin="0,24,0,10" />
                    <DataGrid ItemsSource="{Binding Pagamentos}" SelectedItem="{Binding PagamentoSelecionado}"
                              MaxHeight="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Data" Binding="{Binding DataPagamento, StringFormat=d}" Width="*" />
                            <DataGridTextColumn Header="Valor" Binding="{Binding Valor, StringFormat=C}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Content="Excluir pagamento" Style="{StaticResource SecondaryButton}" Margin="0,10,0,0"
                            Command="{Binding ExcluirPagamentoCommand}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
