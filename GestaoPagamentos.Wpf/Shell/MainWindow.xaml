<Window x:Class="GestaoPagamentos.Wpf.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestão de Pagamentos"
        Width="1200" Height="740" MinWidth="960" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource SidebarBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="22,26,22,22">
                    <Border Background="{StaticResource AccentGradientBrush}" CornerRadius="12"
                            Width="44" Height="44" HorizontalAlignment="Left" Margin="0,0,0,14">
                        <TextBlock Text="$" Foreground="White" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Gestão de" Foreground="#93C5FD" FontSize="13" />
                    <TextBlock Text="Pagamentos" Foreground="White" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="Controle financeiro" Foreground="{StaticResource BorderBrushSoft}" FontSize="12" Margin="0,6,0,0" />
                </StackPanel>

                <ListBox ItemsSource="{Binding Itens}"
                         SelectedItem="{Binding ItemSelecionado}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Margin" Value="10,2" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" CornerRadius="10" Padding="12,11" Background="Transparent"
                                                BorderThickness="2" BorderBrush="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SidebarHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentGradientBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#93C5FD" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Icone}" Foreground="White" FontSize="15" />
                                <TextBlock Grid.Column="1" Text="{Binding Titulo}" Foreground="White" FontSize="14" />
                                <Border Grid.Column="2" Background="{StaticResource DangerBrush}" CornerRadius="9"
                                        MinWidth="20" Padding="6,1"
                                        Visibility="{Binding BadgeVisivel, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="11"
                                               FontWeight="Bold" HorizontalAlignment="Center" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding Conteudo}" Margin="28" />

        <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,24"
                Background="#1E3A8A" CornerRadius="10" Padding="18,12" MaxWidth="460"
                Visibility="{Binding ToastVisivel, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ToastMensagem}" Foreground="White" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
