<UserControl x:Class="GestaoPagamentos.Wpf.Logs.LogsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="Consolas, Courier New"
        Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Background="White" Foreground="#333">
            <!-- Aba de Logs em Tempo Real -->
            <TabItem Header="📺 Logs em Tempo Real">
                <DockPanel Margin="12">
                    <!-- Toolbar -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12" Height="40">
                        <Button Content="🗑️ Limpar Logs" 
                                Command="{Binding LimparLogsCommand}"
                                Padding="12,8" Background="#E74C3C" Foreground="White" 
                                Margin="0,0,8,0" Cursor="Hand" FontSize="12" FontWeight="Bold"/>
                        <Button Content="📄 Abrir Arquivo" 
                                Command="{Binding AbrirArquivoLogCommand}"
                                Padding="12,8" Background="#3498DB" Foreground="White" 
                                Margin="0,0,8,0" Cursor="Hand" FontSize="12" FontWeight="Bold"/>
                        <Button Content="📁 Abrir Pasta" 
                                Command="{Binding AbrirPastaLogCommand}"
                                Padding="12,8" Background="#27AE60" Foreground="White" 
                                Margin="0,0,8,0" Cursor="Hand" FontSize="12" FontWeight="Bold"/>
                        <CheckBox Content="Auto-scroll" IsChecked="{Binding AutoScroll}" 
                                  VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#333"/>
                    </StackPanel>

                    <!-- Contador de eventos -->
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Foreground="#666">
                        <Run Text="Total de eventos: "/>
                        <Run Text="{Binding Eventos.Count, Mode=OneWay}" Foreground="#E74C3C"/>
                        <Run Text=" | Caminho: "/>
                        <Run Text="{Binding CaminhoLogs, Mode=OneWay}" FontSize="11" Foreground="#888"/>
                    </TextBlock>

                    <!-- ListBox com logs -->
                    <ListBox DockPanel.Dock="Top" 
                             ItemsSource="{Binding Eventos}"
                             Background="White" BorderBrush="#DDD"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             FontSize="11">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,4" BorderThickness="0,0,0,1" BorderBrush="#EEE">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Símbolo do nível -->
                                        <TextBlock Grid.Column="0" Text="{Binding LevelSymbol}" 
                                                   Margin="0,0,6,0" VerticalAlignment="Center"/>

                                        <!-- Horário -->
                                        <TextBlock Grid.Column="1" Text="{Binding Timestamp, StringFormat=HH:mm:ss.fff}" 
                                                   Foreground="#888" FontSize="10"/>

                                        <!-- Nível com cores -->
                                        <TextBlock Grid.Column="2" Text="{Binding LevelDisplay}" FontWeight="Bold"
                                                   Foreground="{Binding Level, Converter={StaticResource LogLevelColorConverter}}"/>

                                        <!-- Categoria -->
                                        <TextBlock Grid.Column="3" Text="{Binding Category}" 
                                                   Foreground="#666" FontSize="10" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <!-- Mensagem -->
                                        <TextBlock Grid.Column="4" Text="{Binding Message}" 
                                                   Foreground="#333" TextWrapping="Wrap"
                                                   Margin="12,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- Aba de Diagnóstico -->
            <TabItem Header="🔍 Diagnóstico">
                <ScrollViewer Margin="12">
                    <TextBlock Text="{Binding InformacaoDiagnostico}" 
                               Foreground="#333" FontFamily="Consolas" FontSize="11"
                               TextWrapping="Wrap" LineHeight="22" LineStackingStrategy="BlockLineHeight"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="1" Background="#ECF0F1" BorderThickness="0,1,0,0" BorderBrush="#BDC3C7" Padding="12,8">
            <TextBlock Foreground="#666" FontSize="11">
                <Run Text="ℹ️ Os logs são retidos por 7 dias. Você pode visualizar o arquivo completo na pasta Logs."/>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
